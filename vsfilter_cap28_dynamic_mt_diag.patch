 #include "constants.h"
@@ -319,8 +321,36 @@ auto CSynthFilter::Receive(IMediaSample *pSample) -> HRESULT {
     AM_MEDIA_TYPE *pmt;
     pSample->GetMediaType(&pmt);
     if (pmt != nullptr && pmt->pbFormat != nullptr) {
+        const CMediaType &oldType = m_pInput->CurrentMediaType();
+        const bool sameHeader =
+            oldType.majortype == pmt->majortype &&
+            oldType.subtype == pmt->subtype &&
+            oldType.formattype == pmt->formattype &&
+            oldType.bFixedSizeSamples == pmt->bFixedSizeSamples &&
+            oldType.bTemporalCompression == pmt->bTemporalCompression &&
+            oldType.lSampleSize == pmt->lSampleSize;
+        const bool sameFormatBlock =
+            oldType.cbFormat == pmt->cbFormat &&
+            (oldType.cbFormat == 0 ||
+             (oldType.pbFormat != nullptr && pmt->pbFormat != nullptr &&
+              std::memcmp(oldType.pbFormat, pmt->pbFormat, oldType.cbFormat) == 0));
+        REFERENCE_TIME sampleStartTime = 0;
+        REFERENCE_TIME sampleStopTime = 0;
+        const HRESULT sampleTimeHr = pSample->GetTime(&sampleStartTime, &sampleStopTime);
+        const HRESULT discontinuityHr = pSample->IsDiscontinuity();
+        Environment::GetInstance().Log(
+            L"DYNAMIC_MT time_hr 0x%08X start %10lld stop %10lld discontinuity_hr 0x%08X "
+            L"same_header %d same_format_block %d "
+            L"old major %08lX subtype %08lX formattype %08lX cbFormat %lu sampleSize %lu "
+            L"new major %08lX subtype %08lX formattype %08lX cbFormat %lu sampleSize %lu",
+            static_cast<unsigned int>(sampleTimeHr), sampleStartTime, sampleStopTime,
+            static_cast<unsigned int>(discontinuityHr), sameHeader, sameFormatBlock,
+            oldType.majortype.Data1, oldType.subtype.Data1, oldType.formattype.Data1,
+            oldType.cbFormat, oldType.lSampleSize,
+            pmt->majortype.Data1, pmt->subtype.Data1, pmt->formattype.Data1,
+            pmt->cbFormat, pmt->lSampleSize);
         m_pInput->CurrentMediaType() = *pmt;
         _inputVideoFormat = Format::GetVideoFormat(*pmt, &MainFrameServer::GetInstance());
         DeleteMediaType(pmt);
         _isInputMediaTypeChanged = true;
     }
